        "        721325, 822120, 821205, 314410, 314205, 342125, 214910, 715220, 300305, 121010,\n",
        "        142305, 142205, 311410, 354305, 414135, 723120, 782115, 723215, 203210, 822115,\n",
        "        410205, 821220, 142320, 721115, 782305, 720110, 352305, 722225, 301105, 212405,\n",
        "        142335, 212410, 514310, 141615, 233210, 711230, 322215, 351305, 514325, 721315,\n",
        "        318205, 730105, 715315, 142705, 142115, 723225, 782310, 354210, 252545, 318605,\n",
        "        721425, 313205, 311515, 318005, 300105, 212420, 351115, 763210, 142405, 954125,\n",
        "        950305, 520110, 354135, 313130, 411030, 724405, 414215, 214420, 911325, 725420,\n",
        "        225140, 723320, 860110, 773355, 821445, 910105, 253215, 142315, 720125, 821440,\n",
        "        910130, 142330, 214315, 214610, 724515, 422105, 410240, 314305, 252705, 724110,\n",
        "        142210, 913115, 811760, 951315, 725310, 252305, 724415, 313115, 214915, 919105,\n",
        "        413105, 123105, 214305, 722310, 723220, 725225, 766145, 252310, 314710, 725020,\n",
        "        731165, 318015, 715605, 724435, 913120, 720135, 773315, 721415, 724505, 840105,\n",
        "        312105, 142535, 142520, 142410, 722210, 722305, 820110, 820105, 717020, 410235,\n",
        "        314125, 352205, 783225, 342105, 318510, 722105, 820125, 731135, 731145, 721205,\n",
        "        720160, 314715, 314720, 314620, 214615, 212310, 253120, 992110, 318420, 214605,\n",
        "        722410, 822125, 142505, 911315, 720140, 771110, 722220, 311715, 317110, 724320,\n",
        "        410230, 311505, 314730, 712225, 725005, 252715, 724105, 818105, 123305, 223530,\n",
        "        141305, 771105, 914405, 911110, 725705, 811105, 731160, 724210, 773205, 715135,\n",
        "        725510, 342110, 521115, 510310, 351105, 202120, 212315, 252515, 252720, 414205,\n",
        "        715305, 818110, 411045, 342305, 318010, 262420, 123110, 123705, 122205, 715610,\n",
        "        954115, 214240, 201215, 991305, 142415, 142510, 141605, 252605, 992120, 514315,\n",
        "        919305, 720220, 720145, 774105, 862120, 317205, 722325, 782110, 811110, 762325,\n",
        "        841115, 813125, 711245, 723235, 203225, 773125, 342315, 410215, 910115, 520105,\n",
        "        317210, 354140, 314615, 351505, 314210, 311615, 422205, 823325, 722415, 351315,\n",
        "        354120, 253115, 261215, 212415, 513435, 252205, 411035, 731170, 722405, 777210,\n",
        "        781105, 241040, 412205, 513425, 262410, 318505, 318710, 318310, 318110, 123405,\n",
        "        123115, 953110, 512105, 992205, 214310, 214330, 214505, 214530, 201210, 201220,\n",
        "        823210, 721110, 722110, 142310, 142110, 142530, 766205, 724115, 914410, 720115,\n",
        "        720130, 810110, 731125, 766315, 821245, 813110, 715115, 766320, 862505, 731175,\n",
        "        731180, 761240, 711215, 641010, 715125, 715210, 203105, 723325, 142325, 773120,\n",
        "        773130, 740105, 410220, 820210, 860105, 420135, 768110, 313125, 313210, 314610,\n",
        "        313505, 316110, 314120, 214365, 214435, 142120, 214930, 214935, 841505, 848210,\n",
        "        848215, 848205\n",
        "    ]\n",
        "\n",
        "    # Mapeamento de Códigos para Nomes (Região, UF, Município, CBO, Raça/Cor, Sexo)\n",
        "    # Para Região, UF e Município, precisaremos de um arquivo de mapeamento externo.\n",
        "    # Por simplicidade, vamos criar mapas básicos aqui. Em produção, use um CSV/Excel de referência.\n",
        "    mapa_regiao = {1: \"Norte\", 2: \"Nordeste\", 3: \"Sudeste\", 4: \"Sul\", 5: \"Centro-Oeste\"}\n",
        "    mapa_uf = {\n",
        "        11: \"RO\", 12: \"AC\", 13: \"AM\", 14: \"RR\", 15: \"PA\", 16: \"AP\", 17: \"TO\",\n",
        "        21: \"MA\", 22: \"PI\", 23: \"CE\", 24: \"RN\", 25: \"PB\", 26: \"PE\", 27: \"AL\", 28: \"SE\", 29: \"BA\",\n",
        "        31: \"MG\", 32: \"ES\", 33: \"RJ\", 35: \"SP\",\n",
        "        41: \"PR\", 42: \"SC\", 43: \"RS\",\n",
        "        50: \"MS\", 51: \"MT\", 52: \"GO\", 53: \"DF\"\n",
        "    }\n",
        "    # Para municípios, um arquivo externo (ex: \"municipios_ibge.csv\") seria ideal.\n",
        "    # Exemplo de como carregar um mapa de municípios (se o arquivo existir):\n",
        "    # try:\n",
        "    #     df_municipios = pd.read_csv(os.path.join(CAMINHO_DADOS, \"municipios_ibge.csv\"))\n",
        "    #     mapa_municipio = dict(zip(df_municipios["codigo_ibge"], df_municipios["nome_municipio"]))\n",
        "    # except FileNotFoundError:\n",
        "    #     print(\"Arquivo municipios_ibge.csv não encontrado. Municípios serão exibidos por código.\")\n",
        "    #     mapa_municipio = {}
",
        "    mapa_municipio = {} # Placeholder, idealmente carregado de um CSV
",
        "\n",
        "    mapa_contrato = {-1: \"Demitidos\", 1: \"Admitidos\"}\n",
        "    mapa_sexo = {1: \"Masculino\", 3: \"Feminino\", 9: \"Não Identificado\"}\n",
        "    mapa_raca = {\n",
        "        1: \"Branca\", 2: \"Preta\", 3: \"Parda\", 4: \"Amarela\", \n",
        "        5: \"Indígena\", 6: \"Não Informado\", 9: \"Não Identificado\"\n",
        "    }\n",
        "\n",
        "    arquivos_txt = glob.glob(os.path.join(CAMINHO_CAGED, \"CAGEDMOV*.txt\"))\n",
        "    if not arquivos_txt:\n",
        "        print(\"Nenhum arquivo TXT encontrado. Certifique-se de que os arquivos estão na pasta ", CAMINHO_CAGED, \".\")\n",
        "        return\n",
        "\n",
        "    df_inpc = extrair_indices_inpc()\n",
        "    df_inpc[\"inpc_fator\"] = 1 + df_inpc[\"inpc_val\"] / 100\n",
        "    df_inpc = df_inpc.sort_values(\"Anomes\")\n",
        "    df_inpc[\"inpc_acm\"] = df_inpc[\"inpc_fator\"].cumprod()\n",
        "\n",
        "    lista_consolidada = []\n",
        "\n",
        "    for arquivo in arquivos_txt:\n",
        "        print(f\"Processando {os.path.basename(arquivo)}...\")\n",
        "        \n",
        "        chunk_list = []\n",
        "        for chunk in pd.read_csv(arquivo, sep=\";\", decimal=\",\", usecols=COLUNAS_NECESSARIAS, chunksize=100000):\n",
        "            chunk = chunk[\n",
        "                (chunk[\"categoria\"] != \"111\") &\n",
        "                (chunk[\"seção\"] == \"C\") & # Manter filtro de seção C (Indústria) conforme proposta original\n",
        "                (chunk[\"salário\"] > 396) &\n",
        "                (chunk[\"salário\"] < 50000) &\n",
        "                (chunk[\"salário\"] != 0.00) &\n",
        "                (chunk[\"cbo2002ocupação\"].isin(CBOS_INTERESSE)) # Manter filtro de CBOs de interesse\n",
        "            ]\n",
        "            chunk_list.append(chunk)\n",
        "        \n",
        "        if not chunk_list:\n",
        "            print(f\"Nenhum dado relevante encontrado em {os.path.basename(arquivo)}. Pulando.\")\n",
        "            continue\n",
        "\n",
        "        df_mes = pd.concat(chunk_list)\n",
        "        \n",
        "        df_agrupado = df_mes.groupby(\n",
        "            [\"região\", \"uf\", \"município\", \"cbo2002ocupação\", \"competênciamov\", \"saldomovimentação\", \"sexo\", \"raçacor\"], \n",
        "            as_index=False\n",
        "        ).agg(\n",
        "            Media_Salario=(\"salário\", \"mean\"),\n",
        "            n_movimentacoes=(\"salário\", \"size\")\n",
        "        )\n",
        "        \n",
        "        lista_consolidada.append(df_agrupado)\n",
        "\n",
        "    if not lista_consolidada:\n",
        "        print(\"Nenhum dado consolidado para salvar. Verifique os arquivos de entrada e filtros.\")\n",
        "        return\n",
        "\n",
        "    df_final = pd.concat(lista_consolidada, ignore_index=True)\n",
        "    \n",
        "    df_final[\"contrato\"] = df_final[\"saldomovimentação\"].map(mapa_contrato)\n",
        "    df_final[\"genero\"] = df_final[\"sexo\"].map(mapa_sexo)\n",
        "    df_final[\"etnia\"] = df_final[\"raçacor\"].map(mapa_raca)\n",
        "    df_final[\"nome_regiao\"] = df_final[\"região\"].map(mapa_regiao)\n",
        "    df_final[\"sigla_uf\"] = df_final[\"uf\"].map(mapa_uf)\n",
        "    df_final[\"nome_municipio\"] = df_final[\"município\"].map(mapa_municipio).fillna(df_final[\"município\"]).astype(str) # Fallback para código se nome não encontrado
",
        "    \n",
        "    df_final[\"Anomes\"] = df_final[\"competênciamov\"].astype(str)\n",
        "    df_final = pd.merge(df_final, df_inpc[["Anomes", "inpc_acm"]], on="Anomes", how="left")\n",
        "    df_final[\"Sal_def_INPC\"] = df_final[\"Media_Salario\"] / df_final[\"inpc_acm\"]\n",
        "    \n",
        "    df_dashboard = df_final[[
",
        "        \"Anomes\", \"nome_regiao\", \"sigla_uf\", \"nome_municipio\", \"cbo2002ocupação\", \n",
        "        \"contrato\", \"genero\", \"etnia\", \"Media_Salario\", \"Sal_def_INPC\", \"n_movimentacoes\"
",
        "    ]].rename(columns={\n",
        "        \"cbo2002ocupação\": \"cbo\"\n",
        "    })\n",
        "\n",
        "    caminho_saida = os.path.join(CAMINHO_PROCESSADO, \"dados_dashboard_nacional.parquet\")\n",
        "    df_dashboard.to_parquet(caminho_saida, index=False, compression=\'snappy\')\n",
        "    \n",
        "    print(f\"\\nETL NACIONAL CONCLUÍDO!\")\n",
        "    print(f\"Arquivo gerado: {caminho_saida}\")\n",
        "    print(f\"Total de registros agregados: {len(df_dashboard)}\")\n",
        "\n",
        "# 7. Executar o ETL\n",
        "if __name__ == \"__main__\":\n",
        "    processar_etl_nacional()"
      ],
