      "cell_type": "code",
      "source": [
        "# 5. Função para Extrair Índices INPC\n",
        "# Esta função tenta ler o arquivo indices.csv do seu Drive. \n",
        "# Se não encontrar, ela tenta fazer o scraping do site dadosdemercado.com.br.\n",
        "# É crucial que o arquivo indices.csv esteja presente no seu Drive para dados históricos corretos."
      ],
      "metadata": {
        "id": "inpc_func"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def extrair_indices_inpc():\n",
        "    caminho_inpc = os.path.join(CAMINHO_CAGED, \"indices.csv\")\n",
        "    df_inpc = pd.DataFrame()\n",
        "\n",
        "    if os.path.exists(caminho_inpc):\n",
        "        print(f\"Lendo INPC de {caminho_inpc}...")\n",
        "        df_inpc = pd.read_csv(caminho_inpc)\n",
        "    else:\n",
        "        print(\"Arquivo indices.csv não encontrado no Drive. Tentando fazer scraping...\")\n",
        "        url = \"https://www.dadosdemercado.com.br/indices/inpc\"\n",
        "        try:\n",
        "            response = requests.get(url)\n",
        "            soup = BeautifulSoup(response.content, \"html.parser\")\n",
        "            table = soup.find(\"table\")\n",
        "            df_inpc = pd.read_html(str(table))[0]\n",
        "            df_inpc.to_csv(caminho_inpc, index=False) # Salva para uso futuro\n",
        "            print(f\"INPC extraído e salvo em {caminho_inpc}\")\n",
        "        except Exception as e:\n",
        "            print(f\"Erro ao extrair INPC via scraping: {e}. Por favor, forneça o arquivo indices.csv manualmente.\")\n",
        "            # Criar um dataframe de exemplo se o scraping falhar\n",
        "            df_inpc = pd.DataFrame({\n",
        "                \"Ano\": [2024, 2025, 2026],\n",
        "                \"Jan\": [\"0,50%\", \"0,45%\", \"0,40%\"], \"Fev\": [\"0,60%\", \"0,55%\", \"0,50%\"],\n",
        "                \"Mar\": [\"0,40%\", \"0,35%\", \"0,30%\"], \"Abr\": [\"0,30%\", \"0,25%\", \"0,20%\"],\n",
        "                \"Mai\": [\"0,20%\", \"0,15%\", \"0,10%\"], \"Jun\": [\"0,10%\", \"0,05%\", \"0,00%\"],\n",
        "                \"Jul\": [\"0,15%\", \"0,10%\", \"0,05%\"], \"Ago\": [\"0,25%\", \"0,20%\", \"0,15%\"],\n",
        "                \"Set\": [\"0,35%\", \"0,30%\", \"0,25%\"], \"Out\": [\"0,45%\", \"0,40%\", \"0,35%\"],\n",
        "                \"Nov\": [\"0,55%\", \"0,50%\", \"0,45%\"], \"Dez\": [\"0,65%\", \"0,60%\", \"0,55%\"]\n",
        "            })\n",
        "\n",
        "    if df_inpc.empty:\n",
        "        raise ValueError(\"Não foi possível obter os dados do INPC. Verifique a conexão ou o arquivo indices.csv.\")\n",
        "\n",
        "    inpc_long = df_inpc.melt(\n",
        "        id_vars=[\"Ano\"],\n",
        "        value_vars=[\"Jan\",\"Fev\",\"Mar\",\"Abr\",\"Mai\",\"Jun\",\"Jul\",\"Ago\",\"Set\",\"Out\",\"Nov\",\"Dez\"],\n",
        "        var_name=\"mes_nome\",\n",
        "        value_name=\"inpc_val\"\n",
        "    )\n",
        "    \n",
        "    mapa_meses = {\n",
        "        \"Jan\":\"01\",\"Fev\":\"02\",\"Mar\":\"03\",\"Abr\":\"04\",\"Mai\":\"05\",\"Jun\":\"06\",\n",
        "        \"Jul\":\"07\",\"Ago\":\"08\",\"Set\":\"09\",\"Out\":\"10\",\"Nov\":\"11\",\"Dez\":\"12\"\n",
        "    }\n",
        "    inpc_long[\"mes\"] = inpc_long[\"mes_nome\"].map(mapa_meses)\n",
        "    inpc_long[\"Anomes\"] = inpc_long[\"Ano\"].astype(str) + inpc_long[\"mes\"]\n",
        "    \n",
        "    inpc_long[\"inpc_val\"] = (\n",
        "        inpc_long[\"inpc_val\"]\n",
        "        .astype(str)\n",
        "        .str.replace(\",\", \".\", regex=False)\n",
        "        .str.replace(\"%\", \"\", regex=False)\n",
        "    )\n",
        "    inpc_long[\"inpc_val\"] = pd.to_numeric(inpc_long[\"inpc_val\"], errors=\"coerce\")\n",
        "    \n",
        "    return inpc_long[["Anomes", "inpc_val"]].dropna()"
      ],
      "metadata": {
        "id": "inpc_code"
      },
      "execution_count": null,
      "outputs": []
    },
