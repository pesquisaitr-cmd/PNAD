      "cell_type": "code",
      "source": [
        "CAMINHO_BASE_DRIVE = \"/content/drive/My Drive/PNAD_Dashboard\"\n",
        "CAMINHO_DADOS = os.path.join(CAMINHO_BASE_DRIVE, \"dados\")\n",
        "CAMINHO_CAGED = os.path.join(CAMINHO_DADOS, \"caged\")\n",
        "CAMINHO_PROCESSADO = CAMINHO_DADOS # O arquivo .parquet será salvo diretamente em /dados/
",
        "\n",
        "os.makedirs(CAMINHO_CAGED, exist_ok=True)"
