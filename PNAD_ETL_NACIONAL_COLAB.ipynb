        "def processar_etl_nacional():\n",
        "    COLUNAS_NECESSARIAS = [\n",
        "        \"região\", \"uf\", \"município\", \"cbo2002ocupação\", \"competênciamov\", \n",
        "        \"saldomovimentação\", \"salário\", \"seção\", \"categoria\",\n",
        "        \"sexo\", \"raçacor\"\n",
        "    ]\n",
        "\n",
        "    # Lista de CBOs de interesse (manter para filtrar dados irrelevantes e reduzir tamanho)\n",
        "    CBOS_INTERESSE = [\n",
